<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ghostqueue.controller.LoginController"
      prefHeight="760.0" prefWidth="1200.0"
      style="-fx-background-color: #F5F7F8;">

    <!-- Left Brand Hero Section -->
    <VBox prefWidth="440.0" minWidth="400.0" maxWidth="480.0"
          style="-fx-background-color: linear-gradient(to bottom, #102636, #142A3A); -fx-padding: 48px 40px;"
          HBox.hgrow="NEVER" alignment="TOP_LEFT">

        <!-- Logo & Brand Header -->
        <HBox spacing="14" alignment="CENTER_LEFT">
            <StackPane fx:id="brandLogoContainer" prefWidth="44" prefHeight="44"
                       style="-fx-background-color: rgba(22, 140, 131, 0.2); -fx-background-radius: 10px; -fx-border-color: #168C83; -fx-border-radius: 10px; -fx-border-width: 1px;" />
            <VBox spacing="2">
                <Label text="GHOSTQUEUE" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF; -fx-letter-spacing: 1.5px;" />
                <Label text="HOSPITAL OPERATIONS INTELLIGENCE" style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #168C83; -fx-letter-spacing: 0.8px;" />
            </VBox>
        </HBox>

        <Region prefHeight="40" />

        <!-- Platform Tagline & Mission -->
        <Label text="Predictive Clinical Scheduling &amp; Dynamic Slot Reallocation"
               wrapText="true"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF; -fx-line-spacing: 4px;" />

        <Region prefHeight="16" />

        <Label text="Empowering healthcare providers, attending physicians, and patients with machine learning attendance forecasting and proactive waitlist triage."
               wrapText="true"
               style="-fx-font-size: 13px; -fx-text-fill: #A0B2C6; -fx-line-spacing: 3px;" />

        <Region prefHeight="40" />

        <!-- Feature Highlights -->
        <VBox spacing="20">
            <HBox spacing="14" alignment="TOP_LEFT">
                <StackPane fx:id="featAiIcon" prefWidth="32" prefHeight="32"
                           style="-fx-background-color: rgba(255,255,255,0.06); -fx-background-radius: 6px;" />
                <VBox spacing="3">
                    <Label text="Autonomous No-Show Prediction" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;" />
                    <Label text="Logistic regression engine scoring attendance risk before appointments." wrapText="true"
                           style="-fx-font-size: 11.5px; -fx-text-fill: #8EA0B4;" />
                </VBox>
            </HBox>

            <HBox spacing="14" alignment="TOP_LEFT">
                <StackPane fx:id="featQueueIcon" prefWidth="32" prefHeight="32"
                           style="-fx-background-color: rgba(255,255,255,0.06); -fx-background-radius: 6px;" />
                <VBox spacing="3">
                    <Label text="Multi-Factor Waiting Queue Triage" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;" />
                    <Label text="Smart priority scoring balancing clinical urgency and standby duration." wrapText="true"
                           style="-fx-font-size: 11.5px; -fx-text-fill: #8EA0B4;" />
                </VBox>
            </HBox>

            <HBox spacing="14" alignment="TOP_LEFT">
                <StackPane fx:id="featSecIcon" prefWidth="32" prefHeight="32"
                           style="-fx-background-color: rgba(255,255,255,0.06); -fx-background-radius: 6px;" />
                <VBox spacing="3">
                    <Label text="Enterprise Role Security" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;" />
                    <Label text="PostgreSQL Row-Level Security ensuring patient confidentiality and physician isolation." wrapText="true"
                           style="-fx-font-size: 11.5px; -fx-text-fill: #8EA0B4;" />
                </VBox>
            </HBox>
        </VBox>

        <VBox VBox.vgrow="ALWAYS" />

        <!-- Left Footer -->
        <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-opacity: 0.7;">
            <Label text="GhostQueue Clinical Platform v2.4" style="-fx-font-size: 11px; -fx-text-fill: #77838D;" />
            <Label text="•" style="-fx-text-fill: #77838D;" />
            <Label text="HIPAA &amp; RLS Compliant" style="-fx-font-size: 11px; -fx-text-fill: #77838D;" />
        </HBox>
    </VBox>

    <!-- Right Login Card Section -->
    <VBox HBox.hgrow="ALWAYS" alignment="CENTER" style="-fx-padding: 30px;">
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox alignment="CENTER">
                <VBox maxWidth="480.0" prefWidth="480.0" spacing="22"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-border-color: #E5E9ED; -fx-border-radius: 12px; -fx-border-width: 1px; -fx-padding: 36px 40px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 14, 0, 0, 4);">

                    <!-- Header -->
                    <VBox spacing="6">
                        <Label text="Sign in to your account"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #142A3A;" />
                        <Label text="Enter your registered credentials or select a demo profile below."
                               style="-fx-font-size: 12.5px; -fx-text-fill: #77838D;" />
                    </VBox>

                    <!-- Quick Demo Selection Pills -->
                    <VBox spacing="8">
                        <Label text="ONE-CLICK DEMO ACCESS"
                               style="-fx-font-size: 10.5px; -fx-font-weight: bold; -fx-text-fill: #168C83; -fx-letter-spacing: 0.8px;" />
                        <HBox spacing="8">
                            <Button text="Admin" onAction="#handleAdminDemo"
                                    style="-fx-background-color: #F0F4F8; -fx-text-fill: #142A3A; -fx-font-size: 11.5px; -fx-font-weight: 600; -fx-padding: 6px 14px; -fx-background-radius: 6px; -fx-cursor: hand; -fx-border-color: #D1DDE8; -fx-border-radius: 6px;" />
                            <Button text="Dr. Vance (Cardiology)" onAction="#handleDoctorDemo"
                                    style="-fx-background-color: #E6F5F3; -fx-text-fill: #168C83; -fx-font-size: 11.5px; -fx-font-weight: 600; -fx-padding: 6px 14px; -fx-background-radius: 6px; -fx-cursor: hand; -fx-border-color: #B8E4DF; -fx-border-radius: 6px;" />
                            <Button text="Patient (Eleanor)" onAction="#handlePatientDemo"
                                    style="-fx-background-color: #F8F9FA; -fx-text-fill: #202B35; -fx-font-size: 11.5px; -fx-font-weight: 600; -fx-padding: 6px 14px; -fx-background-radius: 6px; -fx-cursor: hand; -fx-border-color: #E2E6EA; -fx-border-radius: 6px;" />
                        </HBox>
                    </VBox>

                    <Separator />

                    <!-- Error / Alert Banner -->
                    <HBox fx:id="errorBanner" managed="false" visible="false" spacing="10" alignment="CENTER_LEFT"
                          style="-fx-background-color: #FDF2F2; -fx-border-color: #F8B4B4; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 10px 14px;">
                        <StackPane fx:id="errorIconContainer" prefWidth="18" prefHeight="18" />
                        <Label fx:id="errorLabel" text="Error message goes here" wrapText="true"
                               style="-fx-text-fill: #C95F5F; -fx-font-size: 12px; -fx-font-weight: 500;" HBox.hgrow="ALWAYS" />
                    </HBox>

                    <!-- Credentials Form -->
                    <VBox spacing="16">
                        <!-- Email Field -->
                        <VBox spacing="6">
                            <Label text="Work / Healthcare Email Address"
                                   style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #202B35;" />
                            <TextField fx:id="emailField" promptText="name@hospital.org"
                                       style="-fx-background-color: #FFFFFF; -fx-border-color: #D1DDE8; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 10px 12px; -fx-font-size: 13px;" />
                        </VBox>

                        <!-- Password Field -->
                        <VBox spacing="6">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Password"
                                       style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #202B35;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Hyperlink text="Forgot password?" onAction="#handleForgotPassword"
                                           style="-fx-font-size: 11.5px; -fx-text-fill: #168C83; -fx-padding: 0;" />
                            </HBox>
                            <StackPane alignment="CENTER_RIGHT">
                                <PasswordField fx:id="passwordField" promptText="Enter your security password"
                                               style="-fx-background-color: #FFFFFF; -fx-border-color: #D1DDE8; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 10px 38px 10px 12px; -fx-font-size: 13px;" />
                                <TextField fx:id="passwordTextField" managed="false" visible="false" promptText="Enter your security password"
                                           style="-fx-background-color: #FFFFFF; -fx-border-color: #D1DDE8; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 10px 38px 10px 12px; -fx-font-size: 13px;" />
                                <Button fx:id="togglePasswordBtn" onAction="#handleTogglePassword" text="👁"
                                        style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 12px; -fx-padding: 0 10px 0 0;" />
                            </StackPane>
                        </VBox>

                        <!-- Remember Me -->
                        <CheckBox fx:id="rememberMeCheck" text="Remember this workstation"
                                  style="-fx-font-size: 12px; -fx-text-fill: #77838D;" />
                    </VBox>

                    <!-- Submit Button -->
                    <VBox spacing="10">
                        <Button fx:id="signInBtn" text="Sign In to GhostQueue" onAction="#handleSignIn"
                                maxWidth="Infinity" prefHeight="42"
                                style="-fx-background-color: #168C83; -fx-text-fill: #FFFFFF; -fx-font-size: 13.5px; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand;" />
                        <ProgressIndicator fx:id="loadingIndicator" managed="false" visible="false" prefWidth="24" prefHeight="24" />
                    </VBox>

                    <!-- Patient Registration Link -->
                    <HBox alignment="CENTER" spacing="6" style="-fx-padding: 8px 0 0 0;">
                        <Label text="New patient to GhostQueue?" style="-fx-font-size: 12px; -fx-text-fill: #77838D;" />
                        <Hyperlink text="Create a Patient Account" onAction="#handleOpenRegister"
                                   style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #168C83; -fx-padding: 0;" />
                    </HBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </VBox>
</HBox>
