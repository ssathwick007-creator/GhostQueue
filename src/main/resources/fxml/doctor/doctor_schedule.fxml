<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ghostqueue.controller.doctor.DoctorScheduleController"
      spacing="18" style="-fx-padding: 4px;">

    <!-- Control Header -->
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="card" style="-fx-padding: 16px 20px;">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Physician Schedule &amp; Patient Timeline" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #142A3A;" />
            <Label text="Timeline of upcoming consultations, risk assessments, and clinic hours." style="-fx-font-size: 11.5px; -fx-text-fill: #77838D;" />
        </VBox>

        <!-- Time Range Filter Toggle -->
        <HBox spacing="6">
            <Button fx:id="btnFilterToday" text="Today" onAction="#handleFilterToday"
                    style="-fx-background-color: #168C83; -fx-text-fill: #FFFFFF; -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 6px 14px; -fx-background-radius: 6px; -fx-cursor: hand;" />
            <Button fx:id="btnFilterTomorrow" text="Tomorrow" onAction="#handleFilterTomorrow"
                    style="-fx-background-color: #F0F4F8; -fx-text-fill: #142A3A; -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 6px 14px; -fx-background-radius: 6px; -fx-cursor: hand;" />
            <Button fx:id="btnFilterWeek" text="This Week" onAction="#handleFilterWeek"
                    style="-fx-background-color: #F0F4F8; -fx-text-fill: #142A3A; -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 6px 14px; -fx-background-radius: 6px; -fx-cursor: hand;" />
            <Button fx:id="btnFilterAll" text="All" onAction="#handleFilterAll"
                    style="-fx-background-color: #F0F4F8; -fx-text-fill: #142A3A; -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 6px 14px; -fx-background-radius: 6px; -fx-cursor: hand;" />
        </HBox>

        <TextField fx:id="searchField" promptText="Search patients or reasons..." prefWidth="220"
                   style="-fx-background-color: #FFFFFF; -fx-border-color: #D1DDE8; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 7px 12px; -fx-font-size: 12.5px;" />
    </HBox>

    <!-- Table -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="12">
        <TableView fx:id="scheduleTable" VBox.vgrow="ALWAYS" styleClass="modern-table">
            <columns>
                <TableColumn fx:id="colId" prefWidth="110.0" text="APPOINTMENT ID" />
                <TableColumn fx:id="colPatient" prefWidth="240.0" text="PATIENT NAME" />
                <TableColumn fx:id="colDate" prefWidth="120.0" text="DATE" />
                <TableColumn fx:id="colTime" prefWidth="100.0" text="TIME" />
                <TableColumn fx:id="colRisk" prefWidth="140.0" text="PREDICTED RISK" />
                <TableColumn fx:id="colStatus" prefWidth="130.0" text="STATUS" />
                <TableColumn fx:id="colReason" prefWidth="300.0" text="CHIEF COMPLAINT" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

</VBox>
