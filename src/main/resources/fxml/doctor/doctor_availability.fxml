<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ghostqueue.controller.doctor.DoctorAvailabilityController"
            fitToWidth="true"
            style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">

    <VBox spacing="24" style="-fx-padding: 4px;">

        <!-- Header Card -->
        <VBox styleClass="card" spacing="8" style="-fx-padding: 24px;">
            <Label text="Physician Availability &amp; Shift Schedule" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #142A3A;" />
            <Label text="Configure active clinic days, consultation slot hours, and on-duty availability."
                   style="-fx-font-size: 12.5px; -fx-text-fill: #77838D;" />
        </VBox>

        <!-- Availability Form Card -->
        <VBox styleClass="card" spacing="24" style="-fx-padding: 28px;">

            <!-- Overall Status -->
            <VBox spacing="10">
                <Label text="Current Practice Status *" style="-fx-font-size: 13.5px; -fx-font-weight: bold; -fx-text-fill: #142A3A;" />
                <HBox spacing="16">
                    <RadioButton fx:id="radioAvailable" text="Available (Accepting Appointments)"
                                 style="-fx-font-size: 13px; -fx-text-fill: #168C83; -fx-font-weight: 600;" />
                    <RadioButton fx:id="radioBusy" text="Busy / In Surgery"
                                 style="-fx-font-size: 13px; -fx-text-fill: #D99A42; -fx-font-weight: 600;" />
                    <RadioButton fx:id="radioLeave" text="On Leave"
                                 style="-fx-font-size: 13px; -fx-text-fill: #C95F5F; -fx-font-weight: 600;" />
                </HBox>
            </VBox>

            <Separator />

            <!-- Working Days -->
            <VBox spacing="10">
                <Label text="Active Clinic Days *" style="-fx-font-size: 13.5px; -fx-font-weight: bold; -fx-text-fill: #142A3A;" />
                <HBox spacing="20">
                    <CheckBox fx:id="checkMon" text="Monday" selected="true" style="-fx-font-size: 12.5px;" />
                    <CheckBox fx:id="checkTue" text="Tuesday" selected="true" style="-fx-font-size: 12.5px;" />
                    <CheckBox fx:id="checkWed" text="Wednesday" selected="true" style="-fx-font-size: 12.5px;" />
                    <CheckBox fx:id="checkThu" text="Thursday" selected="true" style="-fx-font-size: 12.5px;" />
                    <CheckBox fx:id="checkFri" text="Friday" selected="true" style="-fx-font-size: 12.5px;" />
                    <CheckBox fx:id="checkSat" text="Saturday" style="-fx-font-size: 12.5px;" />
                </HBox>
            </VBox>

            <Separator />

            <!-- Working Hours -->
            <VBox spacing="12">
                <Label text="Daily Consultation Hours *" style="-fx-font-size: 13.5px; -fx-font-weight: bold; -fx-text-fill: #142A3A;" />
                <GridPane hgap="20" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33" />
                        <ColumnConstraints percentWidth="33" />
                        <ColumnConstraints percentWidth="33" />
                    </columnConstraints>

                    <VBox spacing="6" GridPane.columnIndex="0">
                        <Label text="Clinic Start Time" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #5A7184;" />
                        <ComboBox fx:id="startTimeCombo" maxWidth="Infinity" style="-fx-background-color: #FFFFFF; -fx-border-color: #D1DDE8; -fx-border-radius: 6px;" />
                    </VBox>

                    <VBox spacing="6" GridPane.columnIndex="1">
                        <Label text="Clinic End Time" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #5A7184;" />
                        <ComboBox fx:id="endTimeCombo" maxWidth="Infinity" style="-fx-background-color: #FFFFFF; -fx-border-color: #D1DDE8; -fx-border-radius: 6px;" />
                    </VBox>

                    <VBox spacing="6" GridPane.columnIndex="2">
                        <Label text="Slot Duration" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #5A7184;" />
                        <ComboBox fx:id="slotDurationCombo" maxWidth="Infinity" style="-fx-background-color: #FFFFFF; -fx-border-color: #D1DDE8; -fx-border-radius: 6px;" />
                    </VBox>
                </GridPane>
            </VBox>

            <!-- Save Action -->
            <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10px 0 0 0;">
                <Button fx:id="saveBtn" text="Save Availability Preferences" onAction="#handleSaveAvailability"
                        style="-fx-background-color: #168C83; -fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10px 24px; -fx-background-radius: 6px; -fx-cursor: hand;" />
            </HBox>

        </VBox>

    </VBox>
</ScrollPane>
