<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ghostqueue.controller.doctor.DoctorProfileController"
            fitToWidth="true"
            style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">

    <VBox spacing="24" style="-fx-padding: 4px;">

        <!-- Header Card -->
        <VBox styleClass="card" spacing="8" style="-fx-padding: 24px;">
            <Label text="Attending Physician Profile &amp; Clinical Credentials" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #142A3A;" />
            <Label text="Specialist credentials, assigned department, and institutional contact details."
                   style="-fx-font-size: 12.5px; -fx-text-fill: #77838D;" />
        </VBox>

        <!-- Profile Details Card -->
        <VBox styleClass="card" spacing="22" style="-fx-padding: 28px;">

            <Label text="Physician Credentials &amp; Specialty" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #142A3A;" />

            <GridPane hgap="20" vgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" />
                    <ColumnConstraints percentWidth="50" />
                </columnConstraints>

                <!-- Doctor ID -->
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Hospital Physician ID" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #77838D;" />
                    <TextField fx:id="doctorIdField" editable="false"
                               style="-fx-background-color: #F8F9FA; -fx-border-color: #E2E6EA; -fx-border-radius: 6px; -fx-padding: 9px 12px; -fx-text-fill: #5A7184;" />
                </VBox>

                <!-- Full Name -->
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Physician Full Name" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #77838D;" />
                    <TextField fx:id="fullNameField" editable="false"
                               style="-fx-background-color: #F8F9FA; -fx-border-color: #E2E6EA; -fx-border-radius: 6px; -fx-padding: 9px 12px; -fx-text-fill: #5A7184;" />
                </VBox>

                <!-- Department -->
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Clinical Department" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #77838D;" />
                    <TextField fx:id="departmentField" editable="false"
                               style="-fx-background-color: #F8F9FA; -fx-border-color: #E2E6EA; -fx-border-radius: 6px; -fx-padding: 9px 12px; -fx-text-fill: #5A7184;" />
                </VBox>

                <!-- Specialization -->
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Clinical Specialization" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #77838D;" />
                    <TextField fx:id="specializationField" editable="false"
                               style="-fx-background-color: #F8F9FA; -fx-border-color: #E2E6EA; -fx-border-radius: 6px; -fx-padding: 9px 12px; -fx-text-fill: #5A7184;" />
                </VBox>
            </GridPane>

            <Separator />

            <Label text="Institutional Communications" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #142A3A;" />

            <GridPane hgap="20" vgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" />
                    <ColumnConstraints percentWidth="50" />
                </columnConstraints>

                <!-- Email -->
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Institutional Email Address" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #77838D;" />
                    <TextField fx:id="emailField" editable="false"
                               style="-fx-background-color: #F8F9FA; -fx-border-color: #E2E6EA; -fx-border-radius: 6px; -fx-padding: 9px 12px; -fx-text-fill: #5A7184;" />
                </VBox>

                <!-- Phone -->
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Hospital Extension / Contact Phone" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #142A3A;" />
                    <TextField fx:id="phoneField" promptText="+1 (555) 000-0000"
                               style="-fx-background-color: #FFFFFF; -fx-border-color: #D1DDE8; -fx-border-radius: 6px; -fx-padding: 9px 12px;" />
                </VBox>
            </GridPane>

            <!-- Save Button -->
            <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10px 0 0 0;">
                <Button fx:id="saveButton" text="Update Contact Details" onAction="#handleSavePhone"
                        style="-fx-background-color: #168C83; -fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10px 24px; -fx-background-radius: 6px; -fx-cursor: hand;" />
            </HBox>

        </VBox>

    </VBox>
</ScrollPane>
