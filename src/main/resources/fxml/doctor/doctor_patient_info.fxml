<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ghostqueue.controller.doctor.DoctorPatientInfoController"
      spacing="18" style="-fx-padding: 4px;">

    <!-- Control Header -->
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="card" style="-fx-padding: 16px 20px;">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Patient Medical Registry &amp; Attendance Records" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #142A3A;" />
            <Label text="Attendance compliance, clinical records, and contact details for registered patients." style="-fx-font-size: 11.5px; -fx-text-fill: #77838D;" />
        </VBox>

        <TextField fx:id="searchField" promptText="Search patients by name or phone..." prefWidth="280"
                   style="-fx-background-color: #FFFFFF; -fx-border-color: #D1DDE8; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 7px 12px; -fx-font-size: 12.5px;" />

        <Button text="Refresh" onAction="#handleRefresh"
                style="-fx-background-color: #F0F4F8; -fx-text-fill: #142A3A; -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 8px 16px; -fx-background-radius: 6px; -fx-cursor: hand;" />
    </HBox>

    <!-- Table -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="12">
        <TableView fx:id="patientsTable" VBox.vgrow="ALWAYS" styleClass="modern-table">
            <columns>
                <TableColumn fx:id="colId" prefWidth="105.0" text="PATIENT ID" />
                <TableColumn fx:id="colName" prefWidth="220.0" text="PATIENT NAME" />
                <TableColumn fx:id="colAge" prefWidth="75.0" text="AGE" />
                <TableColumn fx:id="colGender" prefWidth="95.0" text="GENDER" />
                <TableColumn fx:id="colPhone" prefWidth="140.0" text="PHONE" />
                <TableColumn fx:id="colEmail" prefWidth="200.0" text="EMAIL" />
                <TableColumn fx:id="colTotal" prefWidth="90.0" text="BOOKED" />
                <TableColumn fx:id="colAttended" prefWidth="90.0" text="ATTENDED" />
                <TableColumn fx:id="colNoShows" prefWidth="90.0" text="NO-SHOWS" />
                <TableColumn fx:id="colNotes" prefWidth="220.0" text="CLINICAL NOTES" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

</VBox>
