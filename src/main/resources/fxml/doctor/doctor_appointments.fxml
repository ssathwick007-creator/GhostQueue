<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ghostqueue.controller.doctor.DoctorAppointmentsController"
      spacing="18" style="-fx-padding: 4px;">

    <!-- Control Header -->
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="card" style="-fx-padding: 16px 20px;">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Clinic Queue &amp; Active Consultations" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #142A3A;" />
            <Label text="Manage patient check-ins, record completed consultations, or mark no-shows." style="-fx-font-size: 11.5px; -fx-text-fill: #77838D;" />
        </VBox>

        <ComboBox fx:id="statusFilterCombo" promptText="Filter Status" prefWidth="170"
                  style="-fx-background-color: #FFFFFF; -fx-border-color: #D1DDE8; -fx-border-radius: 6px; -fx-background-radius: 6px;" />

        <TextField fx:id="searchField" promptText="Search patient..." prefWidth="200"
                   style="-fx-background-color: #FFFFFF; -fx-border-color: #D1DDE8; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 7px 12px; -fx-font-size: 12.5px;" />

        <Button text="Refresh" onAction="#handleRefresh"
                style="-fx-background-color: #F0F4F8; -fx-text-fill: #142A3A; -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 8px 16px; -fx-background-radius: 6px; -fx-cursor: hand;" />
    </HBox>

    <!-- Table -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="12">
        <TableView fx:id="consultationsTable" VBox.vgrow="ALWAYS" styleClass="modern-table">
            <columns>
                <TableColumn fx:id="colId" prefWidth="105.0" text="APPOINTMENT ID" />
                <TableColumn fx:id="colPatient" prefWidth="200.0" text="PATIENT NAME" />
                <TableColumn fx:id="colDate" prefWidth="110.0" text="DATE" />
                <TableColumn fx:id="colTime" prefWidth="85.0" text="TIME" />
                <TableColumn fx:id="colStatus" prefWidth="120.0" text="STATUS" />
                <TableColumn fx:id="colRisk" prefWidth="120.0" text="NO-SHOW RISK" />
                <TableColumn fx:id="colReason" prefWidth="220.0" text="CHIEF COMPLAINT" />
                <TableColumn fx:id="colActions" prefWidth="280.0" text="CLINICAL ACTIONS" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

</VBox>
