<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ghostqueue.controller.RegisterController"
      prefHeight="800.0" prefWidth="1200.0"
      style="-fx-background-color: #F5F7F8;">

    <!-- Left Brand Column -->
    <VBox prefWidth="420.0" minWidth="380.0" maxWidth="460.0"
          style="-fx-background-color: linear-gradient(to bottom, #102636, #142A3A); -fx-padding: 48px 40px;"
          HBox.hgrow="NEVER" alignment="TOP_LEFT">

        <HBox spacing="14" alignment="CENTER_LEFT">
            <StackPane fx:id="brandLogoContainer" prefWidth="44" prefHeight="44"
                       style="-fx-background-color: rgba(22, 140, 131, 0.2); -fx-background-radius: 10px; -fx-border-color: #168C83; -fx-border-radius: 10px; -fx-border-width: 1px;" />
            <VBox spacing="2">
                <Label text="GHOSTQUEUE" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF; -fx-letter-spacing: 1.5px;" />
                <Label text="PATIENT ACCESS PORTAL" style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #168C83; -fx-letter-spacing: 0.8px;" />
            </VBox>
        </HBox>

        <Region prefHeight="40" />

        <Label text="Join GhostQueue Patient Services"
               wrapText="true"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF; -fx-line-spacing: 4px;" />

        <Region prefHeight="16" />

        <Label text="Create your personal patient portal account to book appointments with hospital specialists, manage upcoming visits, and receive proactive schedule notifications."
               wrapText="true"
               style="-fx-font-size: 13px; -fx-text-fill: #A0B2C6; -fx-line-spacing: 3px;" />

        <Region prefHeight="36" />

        <VBox spacing="18">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <StackPane fx:id="featCalendarIcon" prefWidth="28" prefHeight="28"
                           style="-fx-background-color: rgba(255,255,255,0.06); -fx-background-radius: 6px;" />
                <Label text="Real-time Specialist Booking" style="-fx-font-size: 12.5px; -fx-font-weight: 500; -fx-text-fill: #FFFFFF;" />
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <StackPane fx:id="featRemindIcon" prefWidth="28" prefHeight="28"
                           style="-fx-background-color: rgba(255,255,255,0.06); -fx-background-radius: 6px;" />
                <Label text="Automated Visit Reminders &amp; Confirmations" style="-fx-font-size: 12.5px; -fx-font-weight: 500; -fx-text-fill: #FFFFFF;" />
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <StackPane fx:id="featRecordsIcon" prefWidth="28" prefHeight="28"
                           style="-fx-background-color: rgba(255,255,255,0.06); -fx-background-radius: 6px;" />
                <Label text="Integrated Consultation History &amp; Records" style="-fx-font-size: 12.5px; -fx-font-weight: 500; -fx-text-fill: #FFFFFF;" />
            </HBox>
        </VBox>

        <VBox VBox.vgrow="ALWAYS" />

        <Button text="← Back to Sign In" onAction="#handleBackToLogin"
                style="-fx-background-color: transparent; -fx-text-fill: #A0B2C6; -fx-font-size: 12.5px; -fx-cursor: hand; -fx-padding: 0;" />
    </VBox>

    <!-- Right Form Section -->
    <VBox HBox.hgrow="ALWAYS" alignment="CENTER" style="-fx-padding: 24px;">
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox alignment="CENTER">
                <VBox maxWidth="560.0" prefWidth="560.0" spacing="20"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-border-color: #E5E9ED; -fx-border-radius: 12px; -fx-border-width: 1px; -fx-padding: 32px 38px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 14, 0, 0, 4);">

                    <VBox spacing="4">
                        <Label text="Patient Registration"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #142A3A;" />
                        <Label text="Please provide your personal and contact details to set up your account."
                               style="-fx-font-size: 12px; -fx-text-fill: #77838D;" />
                    </VBox>

                    <!-- Error Banner -->
                    <HBox fx:id="errorBanner" managed="false" visible="false" spacing="10" alignment="CENTER_LEFT"
                          style="-fx-background-color: #FDF2F2; -fx-border-color: #F8B4B4; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 10px 14px;">
                        <StackPane fx:id="errorIconContainer" prefWidth="18" prefHeight="18" />
                        <Label fx:id="errorLabel" text="Error details" wrapText="true"
                               style="-fx-text-fill: #C95F5F; -fx-font-size: 12px; -fx-font-weight: 500;" HBox.hgrow="ALWAYS" />
                    </HBox>

                    <!-- Form Grid -->
                    <GridPane hgap="16" vgap="14">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" />
                            <ColumnConstraints percentWidth="50" />
                        </columnConstraints>

                        <!-- Full Name (Spans 2 cols) -->
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2">
                            <Label text="Full Legal Name *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #202B35;" />
                            <TextField fx:id="fullNameField" promptText="e.g. John Doe"
                                       style="-fx-background-color: #FFFFFF; -fx-border-color: #D1DDE8; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 9px 12px;" />
                        </VBox>

                        <!-- Email Address -->
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="Email Address *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #202B35;" />
                            <TextField fx:id="emailField" promptText="patient@example.com"
                                       style="-fx-background-color: #FFFFFF; -fx-border-color: #D1DDE8; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 9px 12px;" />
                        </VBox>

                        <!-- Phone Number -->
                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="Mobile Phone *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #202B35;" />
                            <TextField fx:id="phoneField" promptText="+1 (555) 000-0000"
                                       style="-fx-background-color: #FFFFFF; -fx-border-color: #D1DDE8; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 9px 12px;" />
                        </VBox>

                        <!-- Password -->
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <Label text="Password *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #202B35;" />
                            <PasswordField fx:id="passwordField" promptText="Minimum 6 characters"
                                           style="-fx-background-color: #FFFFFF; -fx-border-color: #D1DDE8; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 9px 12px;" />
                        </VBox>

                        <!-- Confirm Password -->
                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <Label text="Confirm Password *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #202B35;" />
                            <PasswordField fx:id="confirmPasswordField" promptText="Re-enter password"
                                           style="-fx-background-color: #FFFFFF; -fx-border-color: #D1DDE8; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 9px 12px;" />
                        </VBox>

                        <!-- Date of Birth -->
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="3">
                            <Label text="Date of Birth *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #202B35;" />
                            <DatePicker fx:id="dobPicker" promptText="YYYY-MM-DD" maxWidth="Infinity"
                                        style="-fx-background-color: #FFFFFF; -fx-border-color: #D1DDE8; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 6px 10px;" />
                        </VBox>

                        <!-- Gender -->
                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="3">
                            <Label text="Gender *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #202B35;" />
                            <ComboBox fx:id="genderCombo" maxWidth="Infinity" promptText="Select gender"
                                      style="-fx-background-color: #FFFFFF; -fx-border-color: #D1DDE8; -fx-border-radius: 6px; -fx-background-radius: 6px;" />
                        </VBox>

                        <!-- Residential Address (Spans 2 cols) -->
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2">
                            <Label text="Residential Address" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #202B35;" />
                            <TextField fx:id="addressField" promptText="Street address, City, State, Postal Code"
                                       style="-fx-background-color: #FFFFFF; -fx-border-color: #D1DDE8; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 9px 12px;" />
                        </VBox>
                    </GridPane>

                    <!-- Terms checkbox -->
                    <CheckBox fx:id="termsCheck" text="I agree to the GhostQueue Healthcare Terms of Service &amp; HIPAA Privacy Policy"
                              style="-fx-font-size: 11.5px; -fx-text-fill: #77838D;" wrapText="true" />

                    <!-- Submit Button -->
                    <VBox spacing="10">
                        <Button fx:id="registerBtn" text="Create Patient Account" onAction="#handleRegister"
                                maxWidth="Infinity" prefHeight="42"
                                style="-fx-background-color: #168C83; -fx-text-fill: #FFFFFF; -fx-font-size: 13.5px; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand;" />
                        <ProgressIndicator fx:id="loadingIndicator" managed="false" visible="false" prefWidth="24" prefHeight="24" />
                    </VBox>

                    <!-- Back to login link -->
                    <HBox alignment="CENTER" spacing="6">
                        <Label text="Already registered with GhostQueue?" style="-fx-font-size: 12px; -fx-text-fill: #77838D;" />
                        <Hyperlink text="Sign In" onAction="#handleBackToLogin"
                                   style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #168C83; -fx-padding: 0;" />
                    </HBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </VBox>
</HBox>
