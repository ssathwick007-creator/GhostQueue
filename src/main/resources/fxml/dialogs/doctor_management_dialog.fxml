<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="640.0" prefWidth="960.0" spacing="16" stylesheets="@../../css/theme.css"
      style="-fx-background-color: #F5F6F4; -fx-padding: 20px;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ghostqueue.controller.DoctorManagementDialogController">

    <!-- Header Section -->
    <VBox styleClass="card" spacing="12">
        <HBox alignment="CENTER_LEFT" spacing="14">
            <VBox spacing="2">
                <Label text="Medical Staff &amp; Doctor Management" styleClass="card-title" />
                <Label text="Physician registry, clinical specialties, real-time availability management and consultation schedules" styleClass="card-subtitle" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleOpenAddDoctor" styleClass="btn-primary" text="+ Add Doctor" />
        </HBox>

        <!-- Filters Toolbar -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <TextField fx:id="searchField" promptText="Search doctor by name, ID, or specialization..."
                       styleClass="text-field" prefWidth="280" />
            <ComboBox fx:id="departmentFilter" prefWidth="180" promptText="All Departments" />
            <ComboBox fx:id="availabilityFilter" prefWidth="150" promptText="All Statuses" />
            <Button onAction="#handleClearFilters" styleClass="btn-secondary" text="Clear" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="doctorCountLabel" text="Total: 6 doctors" styleClass="card-subtitle" />
        </HBox>
    </VBox>

    <!-- Master Roster & Doctor Details / Schedules -->
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <!-- Doctors Table -->
        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="10">
            <Label text="Clinical Specialists Directory" styleClass="card-title" style="-fx-font-size: 14px;" />
            <TableView fx:id="doctorsTable" prefHeight="420" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="75" />
                    <TableColumn fx:id="colName" text="Doctor Name" prefWidth="160" />
                    <TableColumn fx:id="colDept" text="Department" prefWidth="130" />
                    <TableColumn fx:id="colSpec" text="Specialization" prefWidth="160" />
                    <TableColumn fx:id="colPhone" text="Contact" prefWidth="120" />
                    <TableColumn fx:id="colAvailability" text="Availability" prefWidth="110" />
                </columns>
                <placeholder>
                    <Label text="No doctors match search criteria." styleClass="card-subtitle" />
                </placeholder>
            </TableView>
        </VBox>

        <!-- Doctor Detail & Associated Appointments -->
        <VBox styleClass="card" prefWidth="380" spacing="14">
            <HBox alignment="CENTER_LEFT">
                <Label text="Doctor Profile" styleClass="card-title" style="-fx-font-size: 14px;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleEditSelectedDoctor" styleClass="btn-secondary, btn-sm" text="Edit" />
            </HBox>

            <VBox spacing="6" style="-fx-background-color: #F5F6F4; -fx-padding: 12px; -fx-background-radius: 6px;">
                <Label fx:id="detailDoctorName" text="Select a doctor" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #172A3A;" />
                <Label fx:id="detailDoctorId" text="Doctor ID: —" styleClass="card-subtitle" />
                <Label fx:id="detailDepartment" text="Department: —" styleClass="card-subtitle" />
                <Label fx:id="detailSpecialization" text="Specialization: —" styleClass="card-subtitle" />
                <Label fx:id="detailPhone" text="Phone: —" styleClass="card-subtitle" />
                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 4px 0 0 0;">
                    <Label text="Current Status:" styleClass="card-subtitle" />
                    <Label fx:id="detailStatusLabel" text="AVAILABLE" styleClass="badge, badge-confirmed" />
                </HBox>
            </VBox>

            <!-- Quick Availability Action Buttons -->
            <VBox spacing="6">
                <Label text="Update Availability Status:" style="-fx-font-weight: 600; -fx-font-size: 11px; -fx-text-fill: #77838D;" />
                <HBox spacing="8">
                    <Button onAction="#handleSetAvailable" styleClass="btn-secondary, btn-sm" text="Available" style="-fx-text-fill: #438B70;" />
                    <Button onAction="#handleSetBusy" styleClass="btn-secondary, btn-sm" text="In Clinic / Busy" style="-fx-text-fill: #D99A42;" />
                    <Button onAction="#handleSetOnLeave" styleClass="btn-secondary, btn-sm" text="On Leave" style="-fx-text-fill: #C95F5F;" />
                </HBox>
            </VBox>

            <!-- Associated Appointments -->
            <VBox spacing="6" VBox.vgrow="ALWAYS">
                <Label text="Associated Appointments Roster" style="-fx-font-weight: 600; -fx-font-size: 12px; -fx-text-fill: #77838D;" />
                <TableView fx:id="doctorAppointmentsTable" prefHeight="180" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colApptId" text="Appt ID" prefWidth="75" />
                        <TableColumn fx:id="colPatientName" text="Patient" prefWidth="120" />
                        <TableColumn fx:id="colApptDate" text="Date" prefWidth="85" />
                        <TableColumn fx:id="colApptTime" text="Time" prefWidth="80" />
                    </columns>
                    <placeholder>
                        <Label text="No appointments booked." styleClass="card-subtitle" />
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>
    </HBox>

    <!-- Footer Close Button -->
    <HBox alignment="CENTER_RIGHT">
        <Button onAction="#handleClose" styleClass="btn-secondary" text="Close" />
    </HBox>
</VBox>
