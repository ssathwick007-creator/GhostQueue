<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ghostqueue.controller.patient.PatientDoctorsController"
      spacing="18" style="-fx-padding: 4px;">

    <!-- Control Header -->
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="card" style="-fx-padding: 16px 20px;">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Physicians &amp; Clinical Specialists" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #142A3A;" />
            <Label text="Hospital medical staff directory with specialty credentials and availability." style="-fx-font-size: 11.5px; -fx-text-fill: #77838D;" />
        </VBox>

        <TextField fx:id="searchField" promptText="Search by physician name or specialty..." prefWidth="280"
                   style="-fx-background-color: #FFFFFF; -fx-border-color: #D1DDE8; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 8px 12px; -fx-font-size: 12.5px;" />

        <Button text="Refresh" onAction="#handleRefresh"
                style="-fx-background-color: #F0F4F8; -fx-text-fill: #142A3A; -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 8px 16px; -fx-background-radius: 6px; -fx-cursor: hand;" />
    </HBox>

    <!-- Table -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="12">
        <TableView fx:id="doctorsTable" VBox.vgrow="ALWAYS" styleClass="modern-table">
            <columns>
                <TableColumn fx:id="colId" prefWidth="100.0" text="PHYSICIAN ID" />
                <TableColumn fx:id="colName" prefWidth="240.0" text="DOCTOR NAME" />
                <TableColumn fx:id="colDept" prefWidth="180.0" text="DEPARTMENT" />
                <TableColumn fx:id="colSpec" prefWidth="220.0" text="CLINICAL SPECIALIZATION" />
                <TableColumn fx:id="colPhone" prefWidth="150.0" text="CONTACT" />
                <TableColumn fx:id="colStatus" prefWidth="130.0" text="STATUS" />
                <TableColumn fx:id="colActions" prefWidth="160.0" text="ACTION" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

</VBox>
