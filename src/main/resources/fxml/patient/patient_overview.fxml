<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ghostqueue.controller.patient.PatientOverviewController"
            fitToWidth="true"
            style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">

    <VBox spacing="24" style="-fx-padding: 4px;">

        <!-- Next Appointment Hero Card -->
        <VBox fx:id="nextAppointmentHero"
              style="-fx-background-color: linear-gradient(to right, #102636, #142A3A); -fx-background-radius: 12px; -fx-padding: 26px 30px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 12, 0, 0, 3);">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="NEXT UPCOMING CONSULTATION"
                               style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #168C83; -fx-letter-spacing: 1px;" />
                        <Label fx:id="heroStatusBadge" text="CONFIRMED"
                               style="-fx-background-color: rgba(22, 140, 131, 0.25); -fx-text-fill: #21A69A; -fx-font-size: 10.5px; -fx-font-weight: bold; -fx-padding: 3px 8px; -fx-background-radius: 4px;" />
                    </HBox>
                    <Label fx:id="heroDoctorName" text="Dr. Alexander Vance"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;" />
                    <Label fx:id="heroDepartment" text="Cardiology • Preventive Heart Assessment"
                           style="-fx-font-size: 13px; -fx-text-fill: #A0B2C6;" />

                    <Region prefHeight="8" />

                    <HBox spacing="24" alignment="CENTER_LEFT">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="📅" style="-fx-font-size: 14px;" />
                            <Label fx:id="heroDateLabel" text="Tomorrow, Nov 22, 2026"
                                   style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #FFFFFF;" />
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="⏰" style="-fx-font-size: 14px;" />
                            <Label fx:id="heroTimeLabel" text="09:30 AM"
                                   style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #FFFFFF;" />
                        </HBox>
                    </HBox>
                </VBox>

                <VBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="heroCancelBtn" text="Cancel Appointment" onAction="#handleHeroCancel"
                            style="-fx-background-color: rgba(201, 95, 95, 0.2); -fx-text-fill: #F8B4B4; -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 8px 16px; -fx-background-radius: 6px; -fx-cursor: hand; -fx-border-color: rgba(201, 95, 95, 0.4); -fx-border-radius: 6px;" />
                </VBox>
            </HBox>
        </VBox>

        <!-- No Appointment State Card (Hidden when next appt exists) -->
        <VBox fx:id="noAppointmentCard" managed="false" visible="false"
              style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-padding: 32px; -fx-border-color: #E5E9ED; -fx-border-radius: 12px; -fx-border-width: 1px;" alignment="CENTER" spacing="12">
            <Label text="No Upcoming Appointments Scheduled" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #142A3A;" />
            <Label text="You currently have no pending consultations. Book a slot with a hospital specialist." style="-fx-font-size: 12.5px; -fx-text-fill: #77838D;" />
            <Button text="Book an Appointment Now" onAction="#handleBookShortcut"
                    style="-fx-background-color: #168C83; -fx-text-fill: #FFFFFF; -fx-font-size: 12.5px; -fx-font-weight: 600; -fx-padding: 8px 18px; -fx-background-radius: 6px; -fx-cursor: hand;" />
        </VBox>

        <!-- KPI Metrics Grid -->
        <HBox spacing="18">
            <!-- Card 1 -->
            <VBox HBox.hgrow="ALWAYS" styleClass="card" spacing="8" style="-fx-padding: 20px;">
                <Label text="UPCOMING VISITS" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #77838D; -fx-letter-spacing: 0.6px;" />
                <Label fx:id="upcomingCountLabel" text="1" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #142A3A;" />
                <Label text="Active bookings" style="-fx-font-size: 11.5px; -fx-text-fill: #168C83; -fx-font-weight: 500;" />
            </VBox>

            <!-- Card 2 -->
            <VBox HBox.hgrow="ALWAYS" styleClass="card" spacing="8" style="-fx-padding: 20px;">
                <Label text="COMPLETED VISITS" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #77838D; -fx-letter-spacing: 0.6px;" />
                <Label fx:id="completedCountLabel" text="3" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #142A3A;" />
                <Label text="Past consultations on record" style="-fx-font-size: 11.5px; -fx-text-fill: #77838D;" />
            </VBox>

            <!-- Card 3 -->
            <VBox HBox.hgrow="ALWAYS" styleClass="card" spacing="8" style="-fx-padding: 20px;">
                <Label text="HEALTH NOTIFICATIONS" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #77838D; -fx-letter-spacing: 0.6px;" />
                <Label fx:id="notifCountLabel" text="2" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #142A3A;" />
                <Label text="Reminders &amp; clinic updates" style="-fx-font-size: 11.5px; -fx-text-fill: #168C83; -fx-font-weight: 500;" />
            </VBox>
        </HBox>

        <!-- Quick Booking Callout -->
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: #E6F5F3; -fx-border-color: #B8E4DF; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 20px 24px;">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Looking to schedule another specialist visit?"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #142A3A;" />
                <Label text="Explore open slots across Cardiology, Orthopedics, Pediatrics, Neurology and more."
                       style="-fx-font-size: 12px; -fx-text-fill: #5A7184;" />
            </VBox>
            <Button text="Book Appointment" onAction="#handleBookShortcut"
                    style="-fx-background-color: #168C83; -fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-background-radius: 6px; -fx-cursor: hand;" />
        </HBox>

        <!-- Upcoming Schedule Summary Table -->
        <VBox styleClass="card" spacing="16">
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="2">
                    <Label text="My Scheduled Appointments" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #142A3A;" />
                    <Label text="Upcoming consultations requiring in-person attendance" style="-fx-font-size: 11.5px; -fx-text-fill: #77838D;" />
                </VBox>
            </HBox>

            <TableView fx:id="upcomingTable" prefHeight="220.0" styleClass="modern-table">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="120.0" text="APPOINTMENT ID" />
                    <TableColumn fx:id="colDoctor" prefWidth="220.0" text="DOCTOR" />
                    <TableColumn fx:id="colDept" prefWidth="180.0" text="DEPARTMENT" />
                    <TableColumn fx:id="colDate" prefWidth="130.0" text="DATE" />
                    <TableColumn fx:id="colTime" prefWidth="100.0" text="TIME" />
                    <TableColumn fx:id="colStatus" prefWidth="140.0" text="STATUS" />
                    <TableColumn fx:id="colReason" prefWidth="260.0" text="REASON" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

    </VBox>
</ScrollPane>
