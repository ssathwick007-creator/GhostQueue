<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ghostqueue.controller.patient.PatientHistoryController"
      spacing="18" style="-fx-padding: 4px;">

    <!-- Control Header -->
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="card" style="-fx-padding: 16px 20px;">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Consultation History &amp; Clinical Outcomes" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #142A3A;" />
            <Label text="Past completed visits, cancellations, and clinical attendance log." style="-fx-font-size: 11.5px; -fx-text-fill: #77838D;" />
        </VBox>

        <ComboBox fx:id="statusFilterCombo" promptText="Filter by status" prefWidth="180"
                  style="-fx-background-color: #FFFFFF; -fx-border-color: #D1DDE8; -fx-border-radius: 6px; -fx-background-radius: 6px;" />

        <Button text="Refresh" onAction="#handleRefresh"
                style="-fx-background-color: #F0F4F8; -fx-text-fill: #142A3A; -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 8px 16px; -fx-background-radius: 6px; -fx-cursor: hand;" />
    </HBox>

    <!-- Table -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="12">
        <TableView fx:id="historyTable" VBox.vgrow="ALWAYS" styleClass="modern-table">
            <columns>
                <TableColumn fx:id="colId" prefWidth="110.0" text="APPOINTMENT ID" />
                <TableColumn fx:id="colDoctor" prefWidth="220.0" text="ATTENDING PHYSICIAN" />
                <TableColumn fx:id="colDept" prefWidth="180.0" text="DEPARTMENT" />
                <TableColumn fx:id="colDate" prefWidth="120.0" text="VISIT DATE" />
                <TableColumn fx:id="colTime" prefWidth="90.0" text="TIME" />
                <TableColumn fx:id="colStatus" prefWidth="130.0" text="OUTCOME STATUS" />
                <TableColumn fx:id="colNotes" prefWidth="280.0" text="OUTCOME / CANCELLATION NOTE" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

</VBox>
