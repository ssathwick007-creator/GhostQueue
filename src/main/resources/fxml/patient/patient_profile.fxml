<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ghostqueue.controller.patient.PatientProfileController"
            fitToWidth="true"
            style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">

    <VBox spacing="24" style="-fx-padding: 4px;">

        <!-- Header Card -->
        <VBox styleClass="card" spacing="8" style="-fx-padding: 24px;">
            <Label text="Patient Health Profile &amp; Contact Records" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #142A3A;" />
            <Label text="Review your medical chart identification, primary contact details, and address on file."
                   style="-fx-font-size: 12.5px; -fx-text-fill: #77838D;" />
        </VBox>

        <!-- Form Card -->
        <VBox styleClass="card" spacing="22" style="-fx-padding: 28px;">

            <Label text="Personal Identification" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #142A3A;" />

            <GridPane hgap="20" vgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" />
                    <ColumnConstraints percentWidth="50" />
                </columnConstraints>

                <!-- Patient ID (Read-only) -->
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Patient Registry ID" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #77838D;" />
                    <TextField fx:id="patientIdField" editable="false"
                               style="-fx-background-color: #F8F9FA; -fx-border-color: #E2E6EA; -fx-border-radius: 6px; -fx-padding: 9px 12px; -fx-text-fill: #5A7184;" />
                </VBox>

                <!-- Legal Name -->
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Full Legal Name" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #77838D;" />
                    <TextField fx:id="fullNameField" editable="false"
                               style="-fx-background-color: #F8F9FA; -fx-border-color: #E2E6EA; -fx-border-radius: 6px; -fx-padding: 9px 12px; -fx-text-fill: #5A7184;" />
                </VBox>

                <!-- Age / DOB -->
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Date of Birth / Age" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #77838D;" />
                    <TextField fx:id="dobField" editable="false"
                               style="-fx-background-color: #F8F9FA; -fx-border-color: #E2E6EA; -fx-border-radius: 6px; -fx-padding: 9px 12px; -fx-text-fill: #5A7184;" />
                </VBox>

                <!-- Gender -->
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Biological Gender" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #77838D;" />
                    <TextField fx:id="genderField" editable="false"
                               style="-fx-background-color: #F8F9FA; -fx-border-color: #E2E6EA; -fx-border-radius: 6px; -fx-padding: 9px 12px; -fx-text-fill: #5A7184;" />
                </VBox>
            </GridPane>

            <Separator />

            <Label text="Contact &amp; Residence (Editable)" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #142A3A;" />

            <GridPane hgap="20" vgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" />
                    <ColumnConstraints percentWidth="50" />
                </columnConstraints>

                <!-- Email (Read only) -->
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Registered Email Address" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #77838D;" />
                    <TextField fx:id="emailField" editable="false"
                               style="-fx-background-color: #F8F9FA; -fx-border-color: #E2E6EA; -fx-border-radius: 6px; -fx-padding: 9px 12px; -fx-text-fill: #5A7184;" />
                </VBox>

                <!-- Phone (Editable) -->
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Contact Phone Number *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #142A3A;" />
                    <TextField fx:id="phoneField" promptText="+1 (555) 000-0000"
                               style="-fx-background-color: #FFFFFF; -fx-border-color: #D1DDE8; -fx-border-radius: 6px; -fx-padding: 9px 12px;" />
                </VBox>

                <!-- Address (Editable, spans 2 cols) -->
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                    <Label text="Residential Address *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #142A3A;" />
                    <TextField fx:id="addressField" promptText="Street address, City, State, ZIP"
                               style="-fx-background-color: #FFFFFF; -fx-border-color: #D1DDE8; -fx-border-radius: 6px; -fx-padding: 9px 12px;" />
                </VBox>
            </GridPane>

            <!-- Save Button -->
            <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10px 0 0 0;">
                <Button fx:id="saveButton" text="Update Contact Information" onAction="#handleSaveProfile"
                        style="-fx-background-color: #168C83; -fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10px 24px; -fx-background-radius: 6px; -fx-cursor: hand;" />
            </HBox>

        </VBox>

    </VBox>
</ScrollPane>
