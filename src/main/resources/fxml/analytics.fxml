<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="scroll-pane" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ghostqueue.controller.AnalyticsController">
    <VBox spacing="18">
        <!-- HEADER -->
        <VBox styleClass="card" spacing="4">
            <Label text="Hospital Operational Intelligence &amp; Attendance Analytics" styleClass="card-title" />
            <Label text="Predictive trends, department capacity utilization, no-show attrition rates and slot recovery metrics" styleClass="card-subtitle" />
        </VBox>

        <!-- KPI CARDS -->
        <GridPane hgap="16" vgap="16">
            <VBox styleClass="stat-card" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS" spacing="4">
                <Label text="OVERALL ATTENDANCE RATE" styleClass="stat-label" />
                <Label text="88.4%" styleClass="stat-value" style="-fx-text-fill: #438B70;" />
                <Label text="+4.2% since predictive standby" styleClass="stat-subtext" />
            </VBox>

            <VBox styleClass="stat-card" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" spacing="4">
                <Label text="HOSPITAL NO-SHOW RATE" styleClass="stat-label" />
                <Label text="11.6%" styleClass="stat-value" style="-fx-text-fill: #C95F5F;" />
                <Label text="-3.8% reduction over past quarter" styleClass="stat-subtext" />
            </VBox>

            <VBox styleClass="stat-card" GridPane.columnIndex="2" GridPane.hgrow="ALWAYS" spacing="4">
                <Label text="SLOT RECLAIM EFFICIENCY" styleClass="stat-label" />
                <Label text="74.2%" styleClass="stat-value" style="-fx-text-fill: #168C83;" />
                <Label text="Cancelled slots filled via queue" styleClass="stat-subtext" />
            </VBox>

            <VBox styleClass="stat-card" GridPane.columnIndex="3" GridPane.hgrow="ALWAYS" spacing="4">
                <Label text="AVG QUEUE CLEARANCE" styleClass="stat-label" />
                <Label text="18.5 hrs" styleClass="stat-value" style="-fx-text-fill: #D99A42;" />
                <Label text="Average time to slot offer" styleClass="stat-subtext" />
            </VBox>
        </GridPane>

        <!-- CHARTS SECTION ROW 1 -->
        <HBox spacing="18">
            <!-- Monthly Attendance Trend (Line Chart) -->
            <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="12" prefHeight="330">
                <VBox spacing="2">
                    <Label text="Attendance vs No-Show Historical Trend (Past 6 Months)" styleClass="card-title" />
                    <Label text="Comparison of completed patient consultations vs unannounced absences" styleClass="card-subtitle" />
                </VBox>
                <LineChart fx:id="attendanceTrendChart" prefHeight="260" VBox.vgrow="ALWAYS">
                    <xAxis>
                        <CategoryAxis label="Month" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Patient Appointments" />
                    </yAxis>
                </LineChart>
            </VBox>

            <!-- Department Slot Utilization (Bar Chart) -->
            <VBox styleClass="card" prefWidth="480" spacing="12" prefHeight="330">
                <VBox spacing="2">
                    <Label text="Specialty Slot Utilization (%)" styleClass="card-title" />
                    <Label text="Effective clinic room and physician time utilization" styleClass="card-subtitle" />
                </VBox>
                <BarChart fx:id="utilizationChart" legendVisible="false" prefHeight="260" VBox.vgrow="ALWAYS">
                    <xAxis>
                        <CategoryAxis label="Specialty" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Utilization %" lowerBound="0" upperBound="100" />
                    </yAxis>
                </BarChart>
            </VBox>
        </HBox>

        <!-- INSIGHTS SECTION ROW 2 -->
        <VBox styleClass="card" spacing="14">
            <Label text="Predictive Model Behavioral Insights &amp; Clinical Lead-Time Findings" styleClass="card-title" />

            <GridPane hgap="16" vgap="16">
                <VBox spacing="6" style="-fx-background-color: #F5F6F4; -fx-padding: 16px; -fx-background-radius: 6px;"
                      GridPane.columnIndex="0" GridPane.hgrow="ALWAYS">
                    <Label text="Booking Advance Window" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #172A3A;" />
                    <Label text="Appointments booked &gt; 21 days in advance demonstrate a 3.4x higher probability of no-show compared to appointments scheduled within 72 hours."
                           styleClass="card-subtitle" wrapText="true" />
                </VBox>

                <VBox spacing="6" style="-fx-background-color: #F5F6F4; -fx-padding: 16px; -fx-background-radius: 6px;"
                      GridPane.columnIndex="1" GridPane.hgrow="ALWAYS">
                    <Label text="Time of Day Sensitivity" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #172A3A;" />
                    <Label text="Consultations scheduled after 15:00 show an 18% higher rate of late cancellations. Reallocation engine automatically elevates morning standby queues."
                           styleClass="card-subtitle" wrapText="true" />
                </VBox>

                <VBox spacing="6" style="-fx-background-color: #F5F6F4; -fx-padding: 16px; -fx-background-radius: 6px;"
                      GridPane.columnIndex="2" GridPane.hgrow="ALWAYS">
                    <Label text="Queue Reallocation Value" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #172A3A;" />
                    <Label text="Dynamic reallocation has reclaimed 24 clinical consultation hours this month, preserving physician capacity and shortening elective wait times."
                           styleClass="card-subtitle" wrapText="true" />
                </VBox>
            </GridPane>
        </VBox>
    </VBox>
</ScrollPane>
