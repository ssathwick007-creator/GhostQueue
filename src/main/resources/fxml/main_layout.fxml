<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="850.0" prefWidth="1340.0" stylesheets="@../css/theme.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ghostqueue.controller.MainLayoutController">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox styleClass="sidebar" BorderPane.alignment="CENTER">
            <!-- Brand Header -->
            <VBox styleClass="sidebar-header" spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <StackPane fx:id="brandIconContainer" />
                    <VBox spacing="2">
                        <Label text="GHOSTQUEUE" styleClass="brand-title" />
                        <Label text="Appointment Intelligence" styleClass="brand-subtitle" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- Navigation Items -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
                <VBox styleClass="sidebar-nav-container" spacing="4">
                    <Button fx:id="navOverview" maxWidth="Infinity" onAction="#handleNavOverview"
                            styleClass="nav-button, active" text="Overview" />
                    <Button fx:id="navAppointments" maxWidth="Infinity" onAction="#handleNavAppointments"
                            styleClass="nav-button" text="Appointments" />
                    <Button fx:id="navPrediction" maxWidth="Infinity" onAction="#handleNavPrediction"
                            styleClass="nav-button" text="No-show Prediction" />
                    <Button fx:id="navQueue" maxWidth="Infinity" onAction="#handleNavQueue"
                            styleClass="nav-button" text="Waiting Queue" />
                    <Button fx:id="navReallocation" maxWidth="Infinity" onAction="#handleNavReallocation"
                            styleClass="nav-button" text="Smart Reallocation" />
                    <Button fx:id="navReminders" maxWidth="Infinity" onAction="#handleNavReminders"
                            styleClass="nav-button" text="Reminders &amp; Outreach" />
                    <Button fx:id="navPatients" maxWidth="Infinity" onAction="#handleNavPatients"
                            styleClass="nav-button" text="Patient Records" />
                    <Button fx:id="navAnalytics" maxWidth="Infinity" onAction="#handleNavAnalytics"
                            styleClass="nav-button" text="Analytics" />
                    <Button fx:id="navAccounts" maxWidth="Infinity" onAction="#handleNavAccounts"
                            styleClass="nav-button" text="Account Management" />
                    <Button fx:id="navSettings" maxWidth="Infinity" onAction="#handleNavSettings"
                            styleClass="nav-button" text="Settings" />
                </VBox>
            </ScrollPane>

            <!-- Admin Profile Footer & Sign Out -->
            <VBox styleClass="sidebar-footer" spacing="10">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <StackPane styleClass="user-avatar-circle">
                        <Label fx:id="adminAvatarLabel" text="AD" styleClass="user-avatar-text" />
                    </StackPane>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="adminNameLabel" text="Hospital Administrator" styleClass="user-name" />
                        <Label fx:id="adminRoleLabel" text="Chief Medical Operations" styleClass="user-role" />
                    </VBox>
                </HBox>
                <Button fx:id="logoutButton" text="Sign Out" onAction="#handleLogout" maxWidth="Infinity"
                        style="-fx-background-color: rgba(201, 95, 95, 0.15); -fx-text-fill: #F8B4B4; -fx-font-size: 11.5px; -fx-font-weight: 600; -fx-padding: 7px 12px; -fx-background-radius: 6px; -fx-cursor: hand;" />
            </VBox>
        </VBox>
    </left>

    <!-- CENTER AREA -->
    <center>
        <BorderPane BorderPane.alignment="CENTER">
            <!-- TOP NAVIGATION -->
            <top>
                <HBox alignment="CENTER_LEFT" spacing="18" styleClass="top-nav">
                    <!-- Page Title & Breadcrumb -->
                    <VBox spacing="2">
                        <Label fx:id="breadcrumbLabel" text="Clinical Operations / Overview" styleClass="page-breadcrumb" />
                        <Label fx:id="pageTitleLabel" text="Operations Overview" styleClass="page-title" />
                    </VBox>

                    <Region HBox.hgrow="ALWAYS" />

                    <!-- Search Field -->
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <TextField fx:id="globalSearchField" prefWidth="260.0" promptText="Search patients, doctors, IDs..."
                                   styleClass="search-field" onAction="#handleGlobalSearch" />
                    </HBox>

                    <!-- Date Badge -->
                    <Label fx:id="currentDateLabel" styleClass="date-badge" text="Tue, Nov 17, 2026" />

                    <!-- Notification Button -->
                    <Button fx:id="notificationButton" onAction="#handleNotificationClick" styleClass="icon-btn" text="🔔 3" />

                    <!-- Quick Add Action -->
                    <Button fx:id="quickActionBtn" onAction="#handleQuickAction" styleClass="btn-primary" text="+ New Appointment" />
                </HBox>
            </top>

            <!-- DYNAMIC SCREEN CONTAINER -->
            <center>
                <StackPane fx:id="contentContainer" styleClass="content-area" />
            </center>
        </BorderPane>
    </center>
</BorderPane>
